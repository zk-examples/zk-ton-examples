
import "@stdlib/exotic-cells"

contract MultiplierVerifier {
  description: "Groth16 verifier generated by export-ton-verifier"
  storage: MultiplierVerifierStorage
  incomingMessages: MultiplierVerifierVerify
}

/// This verifier is stateless.
/// It does not provide:
/// - nullifier replay protection;
/// - nonce or query-id protection;
/// - known-root validation;
/// - recipient binding;
/// - chain-id or contract-address domain separation;
/// - state-transition validation.

/// Empty persistent storage; verifier constants are embedded in code.
struct MultiplierVerifierStorage {}

struct MultiplierVerifier {
  ic0: slice
  ic1: slice
  vkGamma2: slice
  vkDelta2: slice
  vkAlpha1: slice
  vkBeta2: slice
  nPublic: int
}

const MultiplierVerifierMinVerifyValue: coins = 50000000

enum MultiplierVerifierErrors {
  InvalidInputs = 258,
  WrongProof = 260,
  NotEnoughValue = 261,
}

fun MultiplierVerifier.create(): MultiplierVerifier {
  return MultiplierVerifier {
    ic0: "a058eb7bdb3b660d61da9dd8d00e40ab4c470306bee24b24cdcdbca83f285c901cdd45d2ea7b363e9a61d471880438f0".hexToSlice(),
    ic1: "b5d1579d3571774958fe296fd03ea71a40ecca5fd9f3d111bbb83291edfc99caecc48911866bf0f23027db668442f83a".hexToSlice(),
    vkGamma2: "93e02b6052719f607dacd3a088274f65596bd0d09920b61ab5da61bbdc7f5049334cf11213945d57e5ac7d055d042b7e024aa2b2f08f0a91260805272dc51051c6e47ad4fa403b02b4510b647ae3d1770bac0326a805bbefd48056c8c121bdb8".hexToSlice(),
    vkDelta2: "a0263c5550a3c4b1303a61d7b4ce1ae720b456d2e2920ad200c684ac72026c66402a9a0a959b7c0c8cc7bfac923f0f03145ef5ad63fbb28adbf0b42285790f1c31a7aa799b8d9891123c9bd5c3779860806fa585a22015e6147511b7170d5d6c".hexToSlice(),
    vkAlpha1: "a293d5acec945b20b4aa6745cc504f4a728762fee3990798f82083eeec6c916bc42cc001363e33d5da4c14c6b09c7382".hexToSlice(),
    vkBeta2: "8b707ad41a9b06144caccd29889a08ebcfe053789db7f86a66de993dbc8a1412b07d27ad1132a1c2f6ba8a794b5ca8f10522015e623816189232044cfdfe54847f959ea930994cc4f07e34c1e6071b915e0d4915c33ac4e6eae516566ea9ee36".hexToSlice(),
    nPublic: 1,
  };
}

/// # Safety
/// Expects both slices to contain canonically encoded BLS12-381 G1 points
/// accepted by the TVM `BLS_G1_ADD` opcode.
@pure fun MultiplierVerifier.blsG1Add(x: slice, y: slice): slice asm "BLS_G1_ADD";

/// # Safety
/// Expects the slice to contain a canonically encoded BLS12-381 G1 point
/// accepted by the TVM `BLS_G1_NEG` opcode.
@pure fun MultiplierVerifier.blsG1Neg(x: slice): slice asm "BLS_G1_NEG";

@pure fun MultiplierVerifier.blsG1InGroup(x: slice): bool asm "BLS_G1_INGROUP";
@pure fun MultiplierVerifier.blsG2InGroup(x: slice): bool asm "BLS_G2_INGROUP";
@pure fun MultiplierVerifier.blsG1IsZero(x: slice): bool asm "BLS_G1_ISZERO";
@pure fun MultiplierVerifier.blsG2IsZero(x: slice): bool asm "BLS_G2_ISZERO";

fun MultiplierVerifier.checkProofPoints(piA: slice, piB: slice, piC: slice) {
  if (
    piA.remainingBitsCount() != 384 || piA.remainingRefsCount() != 0 ||
    piB.remainingBitsCount() != 768 || piB.remainingRefsCount() != 0 ||
    piC.remainingBitsCount() != 384 || piC.remainingRefsCount() != 0
  ) {
    throw MultiplierVerifierErrors.InvalidInputs;
  }
  if (!MultiplierVerifier.blsG1InGroup(piA) || !MultiplierVerifier.blsG2InGroup(piB) || !MultiplierVerifier.blsG1InGroup(piC)) {
    throw MultiplierVerifierErrors.InvalidInputs;
  }
  if (MultiplierVerifier.blsG1IsZero(piA) || MultiplierVerifier.blsG2IsZero(piB) || MultiplierVerifier.blsG1IsZero(piC)) {
    throw MultiplierVerifierErrors.InvalidInputs;
  }
}

fun MultiplierVerifier.loadCheckedG1(point: cell): slice {
  val (pointSlice, isExotic) = point.beginParseSpecial();
  if (isExotic || pointSlice.remainingBitsCount() != 384 || pointSlice.remainingRefsCount() != 0) {
    throw MultiplierVerifierErrors.InvalidInputs;
  }
  return pointSlice;
}

fun MultiplierVerifier.loadCheckedG2(point: cell): slice {
  val (pointSlice, isExotic) = point.beginParseSpecial();
  if (isExotic || pointSlice.remainingBitsCount() != 768 || pointSlice.remainingRefsCount() != 0) {
    throw MultiplierVerifierErrors.InvalidInputs;
  }
  return pointSlice;
}

fun MultiplierVerifier.loadCheckedProof(proof: cell): (slice, slice, slice) {
  val (initialProof, isExotic) = proof.beginParseSpecial();
  var proofSlice = initialProof;
  if (isExotic || proofSlice.remainingBitsCount() != 0 || proofSlice.remainingRefsCount() != 3) {
    throw MultiplierVerifierErrors.InvalidInputs;
  }
  val piA = MultiplierVerifier.loadCheckedG1(proofSlice.loadRef());
  val piB = MultiplierVerifier.loadCheckedG2(proofSlice.loadRef());
  val piC = MultiplierVerifier.loadCheckedG1(proofSlice.loadRef());
  proofSlice.assertEnd();
  return (piA, piB, piC);
}

@pure fun MultiplierVerifier.blsR(): int asm "BLS_PUSHR";

fun MultiplierVerifier.checkPublicInput(x: int): int {
  // TVM scalar multiplication reduces modulo r, so x and x+r would otherwise alias.
  if (x < 0 || x >= MultiplierVerifier.blsR()) {
    throw MultiplierVerifierErrors.InvalidInputs;
  }
  return x;
}

/// # Safety
/// Expects the provided slices to contain canonically encoded BLS12-381 proof
/// and verification-key points in the order required by TVM `BLS_PAIRING`.
@pure fun MultiplierVerifier.blsPairing(
  x1: slice, y1: slice,
  x2: slice, y2: slice,
  x3: slice, y3: slice,
  x4: slice, y4: slice,
  n: int
): int asm "BLS_PAIRING";

/// # Safety
/// Expects x1..x1 to be canonical BLS12-381 G1 points and y1..y1
/// to be scalars encoded in the format expected by TVM `BLS_G1_MULTIEXP`.
@pure
fun MultiplierVerifier.blsG1Multiexp1(
  x1: slice, y1: int,
  n: int
): slice asm "BLS_G1_MULTIEXP";


// Internal messages carry public inputs as a custom payload:
// uint8 length, then canonical three-int257 chunks chained through refs.
fun MultiplierVerifier.checkPublicInputsPayloadShape(payload: slice) {
  var remaining: int = 1;

  while (remaining > 0) {
    var chunk: int = remaining;
    if (chunk > 3) { chunk = 3; }
    if (payload.remainingBitsCount() != chunk * 257) { throw MultiplierVerifierErrors.InvalidInputs; }
    remaining -= chunk;

    if (remaining > 0) {
      if (payload.remainingRefsCount() != 1) { throw MultiplierVerifierErrors.InvalidInputs; }
      val (nextPayload, isExotic) = payload.loadRef().beginParseSpecial();
      if (isExotic) { throw MultiplierVerifierErrors.InvalidInputs; }
      payload = nextPayload;
    } else if (payload.remainingRefsCount() != 0) {
      throw MultiplierVerifierErrors.InvalidInputs;
    }
  }
}

fun MultiplierVerifier.loadNextPubInput(mutate payload: slice): int {
  if (payload.remainingBitsCount() < 257) {
    if (payload.remainingBitsCount() != 0 || payload.remainingRefsCount() != 1) {
      throw MultiplierVerifierErrors.InvalidInputs;
    }
    val (nextPayload, isExotic) = payload.loadRef().beginParseSpecial();
    if (isExotic || nextPayload.remainingBitsCount() < 257) {
      throw MultiplierVerifierErrors.InvalidInputs;
    }
    payload = nextPayload;
  }
  return MultiplierVerifier.checkPublicInput(payload.loadInt(257));
}

fun MultiplierVerifier.finishGroth16(
  self,
  piA: slice,
  piB: slice,
  piC: slice,
  acc: slice,
  haveAcc: bool
): bool {
  // Final cpub = IC0 + acc (IC0 is always added exactly once)
  var cpub: slice;
  if (!haveAcc) {
    cpub = self.ic0;
  } else {
    cpub = MultiplierVerifier.blsG1Add(acc, self.ic0);
  }

  // Pairing check: e(cpub, gamma) * e(-piA, piB) * e(piC, delta) * e(alpha, beta) == 1
  val piANeg: slice = MultiplierVerifier.blsG1Neg(piA);
  val ok: int = MultiplierVerifier.blsPairing(
    cpub,         self.vkGamma2,
    piANeg,       piB,
    piC,          self.vkDelta2,
    self.vkAlpha1, self.vkBeta2,
    4
  );

  return ok != 0;
}

fun MultiplierVerifier.verifyPayload(
  self,
  piA: slice,
  piB: slice,
  piC: slice,
  mutate payload: slice
): bool {
  MultiplierVerifier.checkProofPoints(piA, piB, piC);

  // Compute: cpub = IC0 + sum(pubInputs[i] * IC(i+1))
  var haveAcc: bool = false;
  var acc: slice = self.ic0; // placeholder until haveAcc == true

  val y1: int = MultiplierVerifier.loadNextPubInput(mutate payload);
  acc = MultiplierVerifier.blsG1Multiexp1(
    self.ic1, y1
    , 1
  );
  haveAcc = true;

  if (payload.remainingBitsCount() != 0 || payload.remainingRefsCount() != 0) {
    throw MultiplierVerifierErrors.InvalidInputs;
  }

  return self.finishGroth16(piA, piB, piC, acc, haveAcc);
}

fun MultiplierVerifier.verify(self, piA: slice, piB: slice, piC: slice, pubInputs: array<int>): bool {
  MultiplierVerifier.checkProofPoints(piA, piB, piC);
  if (pubInputs.size() != self.nPublic) { throw MultiplierVerifierErrors.InvalidInputs; }

  // Compute: cpub = IC0 + sum(pubInputs[i] * IC(i+1))
  var haveAcc: bool = false;
  var acc: slice = self.ic0; // placeholder until haveAcc == true

  acc = MultiplierVerifier.blsG1Multiexp1(
    self.ic1, MultiplierVerifier.checkPublicInput(pubInputs.get(0))
    , 1
  );
  haveAcc = true;

  return self.finishGroth16(piA, piB, piC, acc, haveAcc);
}

/// Internal message containing Groth16 proof points and serialized public inputs.
struct (0x3b3cca17) MultiplierVerifierVerify {
  /// Ordinary cell with exactly three refs: piA, piB, piC.
  proof: cell
  /// Ordinary cell with uint8 length followed by a linear int257 ref chain.
  pubInputs: cell
}

fun MultiplierVerifier.verifyProof(self, msg: MultiplierVerifierVerify): bool {
  val (piA, piB, piC) = MultiplierVerifier.loadCheckedProof(msg.proof);
  val (initialPayload, payloadIsExotic) = msg.pubInputs.beginParseSpecial();
  var payload = initialPayload;

  if (payloadIsExotic || payload.remainingBitsCount() < 8) { throw MultiplierVerifierErrors.InvalidInputs; }
  if (payload.loadUint(8) != self.nPublic) { throw MultiplierVerifierErrors.InvalidInputs; }
  MultiplierVerifier.checkPublicInputsPayloadShape(payload);

  return self.verifyPayload(piA, piB, piC, mutate payload);
}

// Convenience standalone entrypoints. Remove or rename them when composing
// multiple verifier structs inside one contract.
fun onInternalMessage(inMsg: InMessage) {
  val msg = lazy MultiplierVerifierVerify.fromSlice(inMsg.body);

  match (msg) {
    MultiplierVerifierVerify => {
      assert (inMsg.valueCoins >= MultiplierVerifierMinVerifyValue) throw MultiplierVerifierErrors.NotEnoughValue;
      val messageTail = msg.forceLoadLazyObject();
      if (!messageTail.isEmpty()) { throw MultiplierVerifierErrors.InvalidInputs; }
      assert (MultiplierVerifier.create().verifyProof(msg)) throw MultiplierVerifierErrors.WrongProof;
    }
    else => {
      assert (inMsg.body.isEmpty()) throw MultiplierVerifierErrors.InvalidInputs;
    }
  }
}


/// Verifies a Groth16 proof against public inputs.
get fun verify_MultiplierVerifier(piA: slice, piB: slice, piC: slice, pubInputs: array<int>): bool {
  return MultiplierVerifier.create().verify(piA, piB, piC, pubInputs);
}
