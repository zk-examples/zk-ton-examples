
contract MultiplierVerifier {
  description: "Groth16 verifier generated by export-ton-verifier"
  storage: MultiplierVerifierStorage
  incomingMessages: MultiplierVerifierVerify
}

/// Empty persistent storage; verifier constants are embedded in code.
struct MultiplierVerifierStorage {}

struct MultiplierVerifier {
  ic0: slice
  ic1: slice
  vkGamma2: slice
  vkDelta2: slice
  vkAlpha1: slice
  vkBeta2: slice
  nPublic: int
}

enum MultiplierVerifierErrors {
  InvalidInputs = 258,
  WrongProof = 260,
}

fun MultiplierVerifier.create(): MultiplierVerifier {
  return MultiplierVerifier {
    ic0: "b376d29165d9993a8d552cf15eb0e1171cec3be8510e78fc47beedea5c58bb03bf112338a81d24725f159afb0b46ff8a".hexToSlice(),
    ic1: "932b7a28b994b701aa1a4c06a4f3f369cbb0b4ddfc37c380679815504757708b5e63936b01f85b1368e7ae328671b499".hexToSlice(),
    vkGamma2: "93e02b6052719f607dacd3a088274f65596bd0d09920b61ab5da61bbdc7f5049334cf11213945d57e5ac7d055d042b7e024aa2b2f08f0a91260805272dc51051c6e47ad4fa403b02b4510b647ae3d1770bac0326a805bbefd48056c8c121bdb8".hexToSlice(),
    vkDelta2: "b1cd4f856100b2e044982b35efc1b2b8198563e364a3f8ad04042f1b2863f2390b4eec671127429b2c5e718acd9551cb133c975867cd365d64985736dad6c003628a909f7e5bbf6640152497313e057159086a69c687baca50953a71c7ab0d89".hexToSlice(),
    vkAlpha1: "b1b83e55445b659621850963559851270e7f209be2ba8ec89529d0705991aa0e369d315ebb4aedb2b38232d29621789e".hexToSlice(),
    vkBeta2: "90c699a329380ef521a9022f0abb0f06f072bf81efab4b8d15bc10186b558335f81f8588f0a43f751fda31f427f7f9cf0238b10a60115bd4e51fa1baaa4d6e1dd8797804f40baa93451fd46b04a2884b4e75cfdb584f457b51544e7fe687da9f".hexToSlice(),
    nPublic: 1,
  };
}

/// # Safety
/// Expects both slices to contain canonically encoded BLS12-381 G1 points
/// accepted by the TVM `BLS_G1_ADD` opcode.
@pure fun MultiplierVerifier.blsG1Add(x: slice, y: slice): slice asm "BLS_G1_ADD";

/// # Safety
/// Expects the slice to contain a canonically encoded BLS12-381 G1 point
/// accepted by the TVM `BLS_G1_NEG` opcode.
@pure fun MultiplierVerifier.blsG1Neg(x: slice): slice asm "BLS_G1_NEG";

/// # Safety
/// Expects the provided slices to contain canonically encoded BLS12-381 proof
/// and verification-key points in the order required by TVM `BLS_PAIRING`.
@pure fun MultiplierVerifier.blsPairing(
  x1: slice, y1: slice,
  x2: slice, y2: slice,
  x3: slice, y3: slice,
  x4: slice, y4: slice,
  n: int
): int asm "BLS_PAIRING";

/// # Safety
/// Expects x1..x1 to be canonical BLS12-381 G1 points and y1..y1
/// to be scalars encoded in the format expected by TVM `BLS_G1_MULTIEXP`.
@pure
fun MultiplierVerifier.blsG1Multiexp1(
  x1: slice, y1: int,
  n: int
): slice asm "BLS_G1_MULTIEXP";


// Internal messages carry public inputs as a custom payload:
// uint8 length, then int257 values chained through refs as needed.
fun MultiplierVerifier.loadNextPubInput(mutate payload: slice): int {
  if (payload.remainingBitsCount() < 257) {
    if (payload.remainingBitsCount() != 0 || payload.remainingRefsCount() == 0) {
      throw MultiplierVerifierErrors.InvalidInputs;
    }
    payload = payload.loadRef().beginParse();
  }
  return payload.loadInt(257);
}

fun MultiplierVerifier.finishGroth16(
  self,
  piA: slice,
  piB: slice,
  piC: slice,
  acc: slice,
  haveAcc: bool
): bool {
  // Final cpub = IC0 + acc (IC0 is always added exactly once)
  var cpub: slice;
  if (!haveAcc) {
    cpub = self.ic0;
  } else {
    cpub = MultiplierVerifier.blsG1Add(acc, self.ic0);
  }

  // Pairing check: e(cpub, gamma) * e(-piA, piB) * e(piC, delta) * e(alpha, beta) == 1
  val piANeg: slice = MultiplierVerifier.blsG1Neg(piA);
  val ok: int = MultiplierVerifier.blsPairing(
    cpub,         self.vkGamma2,
    piANeg,       piB,
    piC,          self.vkDelta2,
    self.vkAlpha1, self.vkBeta2,
    4
  );

  return ok != 0;
}

fun MultiplierVerifier.verifyPayload(
  self,
  piA: slice,
  piB: slice,
  piC: slice,
  mutate payload: slice
): bool {
  // Compute: cpub = IC0 + sum(pubInputs[i] * IC(i+1))
  var haveAcc: bool = false;
  var acc: slice = self.ic0; // placeholder until haveAcc == true

  val y1: int = MultiplierVerifier.loadNextPubInput(mutate payload);
  acc = MultiplierVerifier.blsG1Multiexp1(
    self.ic1, y1
    , 1
  );
  haveAcc = true;

  if (payload.remainingBitsCount() != 0 || payload.remainingRefsCount() != 0) {
    throw MultiplierVerifierErrors.InvalidInputs;
  }

  return self.finishGroth16(piA, piB, piC, acc, haveAcc);
}

fun MultiplierVerifier.verify(self, piA: slice, piB: slice, piC: slice, pubInputs: array<int>): bool {
  if (pubInputs.size() != self.nPublic) { throw MultiplierVerifierErrors.InvalidInputs; }

  // Compute: cpub = IC0 + sum(pubInputs[i] * IC(i+1))
  var haveAcc: bool = false;
  var acc: slice = self.ic0; // placeholder until haveAcc == true

  acc = MultiplierVerifier.blsG1Multiexp1(
    self.ic1, pubInputs.get(0)
    , 1
  );
  haveAcc = true;

  return self.finishGroth16(piA, piB, piC, acc, haveAcc);
}

/// Internal message containing Groth16 proof points and serialized public inputs.
struct (0x3b3cca17) MultiplierVerifierVerify {
  /// G1 proof point piA.
  piA: cell
  /// G2 proof point piB.
  piB: cell
  /// G1 proof point piC.
  piC: cell
  /// uint8 length followed by int257 public inputs chained through refs.
  pubInputs: RemainingBitsAndRefs
}

fun MultiplierVerifier.verifyProof(self, msg: MultiplierVerifierVerify): bool {
  val piA: slice = msg.piA.beginParse();
  val piB: slice = msg.piB.beginParse();
  val piC: slice = msg.piC.beginParse();
  var payload: slice = msg.pubInputs;

  if (payload.loadUint(8) != self.nPublic) { throw MultiplierVerifierErrors.InvalidInputs; }

  return self.verifyPayload(piA, piB, piC, mutate payload);
}

// Convenience standalone entrypoints. Remove or rename them when composing
// multiple verifier structs inside one contract.
fun onInternalMessage(inMsg: InMessage) {
  val msg = lazy MultiplierVerifierVerify.fromSlice(inMsg.body);

  match (msg) {
    MultiplierVerifierVerify => {
      assert (MultiplierVerifier.create().verifyProof(msg)) throw MultiplierVerifierErrors.WrongProof;
    }
    else => {
      assert (inMsg.body.isEmpty()) throw MultiplierVerifierErrors.InvalidInputs;
    }
  }
}


/// Verifies a Groth16 proof against public inputs.
get fun verify_MultiplierVerifier(piA: slice, piB: slice, piC: slice, pubInputs: array<int>): bool {
  return MultiplierVerifier.create().verify(piA, piB, piC, pubInputs);
}
