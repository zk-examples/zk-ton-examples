
import "@stdlib/exotic-cells"

contract ArkVerifier {
  description: "Groth16 verifier generated by export-ton-verifier"
  storage: ArkVerifierStorage
  incomingMessages: ArkVerifierVerify
}

/// This verifier is stateless.
/// It does not provide:
/// - nullifier replay protection;
/// - nonce or query-id protection;
/// - known-root validation;
/// - recipient binding;
/// - chain-id or contract-address domain separation;
/// - state-transition validation.

/// Empty persistent storage; verifier constants are embedded in code.
struct ArkVerifierStorage {}

struct ArkVerifier {
  ic0: slice
  ic1: slice
  vkGamma2: slice
  vkDelta2: slice
  vkAlpha1: slice
  vkBeta2: slice
  nPublic: int
}

const ArkVerifierMinVerifyValue: coins = 50000000

enum ArkVerifierErrors {
  InvalidInputs = 258,
  WrongProof = 260,
  NotEnoughValue = 261,
}

fun ArkVerifier.create(): ArkVerifier {
  return ArkVerifier {
    ic0: "8ac5e8f7c6a6be828b6a9d61dfd39edeac1470de0d020f105879f0945400db0fa5dcff19aa07f94b1d205ae4e0aa2030".hexToSlice(),
    ic1: "89c2a2c0be0166dbe04e987fba86692210ad61e6c55b43c0e95137f8e71197111c003f2c34278cd07f279c389309e294".hexToSlice(),
    vkGamma2: "b2ad8b14b088d8e733636ad283a33fa1d07f4bc68e2751ff7b41e602d222667a34705f308a9fb93d3807edc351b5bb9108c69616e984d8f00ab3a0f32789fb22f628ab866de12ff12b21eeb4f9b3774b23ac423cdb441cae7ce4e45bc419c2e4".hexToSlice(),
    vkDelta2: "a74849fdb33c6ffee0f2c16704c7be36715fa3d4b8b3479472d06f7364ca587b848e9371a0872746a1424bfa2743afb50245c703c1326e50be17478288ed35998d1ea96727dda5783d8d5024fd903ba33141f159c82f84ec72b81e841492bf96".hexToSlice(),
    vkAlpha1: "8e5b5c643d8a97c0f60669ce1c3d3f0fb38331b4fc30bb0ab616ff1ea1f33b7191e9033022a957e9f64d901948a4cb6e".hexToSlice(),
    vkBeta2: "a3db20d891b38d287b576cfc1ade7260eedf7eb859dfabf641868f6edb6504778b03e3afbeb97bbe484ffd8dac4c3071068b64cd8b60485785e3533c59c52f84dd03cfd373254d2f737edb65ba583562db9379d9762bf4fb3cd7df3f8ea9a01b".hexToSlice(),
    nPublic: 1,
  };
}

/// # Safety
/// Expects both slices to contain canonically encoded BLS12-381 G1 points
/// accepted by the TVM `BLS_G1_ADD` opcode.
@pure fun ArkVerifier.blsG1Add(x: slice, y: slice): slice asm "BLS_G1_ADD";

/// # Safety
/// Expects the slice to contain a canonically encoded BLS12-381 G1 point
/// accepted by the TVM `BLS_G1_NEG` opcode.
@pure fun ArkVerifier.blsG1Neg(x: slice): slice asm "BLS_G1_NEG";

@pure fun ArkVerifier.blsG1InGroup(x: slice): bool asm "BLS_G1_INGROUP";
@pure fun ArkVerifier.blsG2InGroup(x: slice): bool asm "BLS_G2_INGROUP";
@pure fun ArkVerifier.blsG1IsZero(x: slice): bool asm "BLS_G1_ISZERO";
@pure fun ArkVerifier.blsG2IsZero(x: slice): bool asm "BLS_G2_ISZERO";

fun ArkVerifier.checkProofPoints(piA: slice, piB: slice, piC: slice) {
  if (
    piA.remainingBitsCount() != 384 || piA.remainingRefsCount() != 0 ||
    piB.remainingBitsCount() != 768 || piB.remainingRefsCount() != 0 ||
    piC.remainingBitsCount() != 384 || piC.remainingRefsCount() != 0
  ) {
    throw ArkVerifierErrors.InvalidInputs;
  }
  if (!ArkVerifier.blsG1InGroup(piA) || !ArkVerifier.blsG2InGroup(piB) || !ArkVerifier.blsG1InGroup(piC)) {
    throw ArkVerifierErrors.InvalidInputs;
  }
  if (ArkVerifier.blsG1IsZero(piA) || ArkVerifier.blsG2IsZero(piB) || ArkVerifier.blsG1IsZero(piC)) {
    throw ArkVerifierErrors.InvalidInputs;
  }
}

fun ArkVerifier.loadCheckedG1(point: cell): slice {
  val (pointSlice, isExotic) = point.beginParseSpecial();
  if (isExotic || pointSlice.remainingBitsCount() != 384 || pointSlice.remainingRefsCount() != 0) {
    throw ArkVerifierErrors.InvalidInputs;
  }
  return pointSlice;
}

fun ArkVerifier.loadCheckedG2(point: cell): slice {
  val (pointSlice, isExotic) = point.beginParseSpecial();
  if (isExotic || pointSlice.remainingBitsCount() != 768 || pointSlice.remainingRefsCount() != 0) {
    throw ArkVerifierErrors.InvalidInputs;
  }
  return pointSlice;
}

fun ArkVerifier.loadCheckedProof(proof: cell): (slice, slice, slice) {
  val (initialProof, isExotic) = proof.beginParseSpecial();
  var proofSlice = initialProof;
  if (isExotic || proofSlice.remainingBitsCount() != 0 || proofSlice.remainingRefsCount() != 3) {
    throw ArkVerifierErrors.InvalidInputs;
  }
  val piA = ArkVerifier.loadCheckedG1(proofSlice.loadRef());
  val piB = ArkVerifier.loadCheckedG2(proofSlice.loadRef());
  val piC = ArkVerifier.loadCheckedG1(proofSlice.loadRef());
  proofSlice.assertEnd();
  return (piA, piB, piC);
}

@pure fun ArkVerifier.blsR(): int asm "BLS_PUSHR";

fun ArkVerifier.checkPublicInput(x: int): int {
  // TVM scalar multiplication reduces modulo r, so x and x+r would otherwise alias.
  if (x < 0 || x >= ArkVerifier.blsR()) {
    throw ArkVerifierErrors.InvalidInputs;
  }
  return x;
}

/// # Safety
/// Expects the provided slices to contain canonically encoded BLS12-381 proof
/// and verification-key points in the order required by TVM `BLS_PAIRING`.
@pure fun ArkVerifier.blsPairing(
  x1: slice, y1: slice,
  x2: slice, y2: slice,
  x3: slice, y3: slice,
  x4: slice, y4: slice,
  n: int
): int asm "BLS_PAIRING";

/// # Safety
/// Expects x1..x1 to be canonical BLS12-381 G1 points and y1..y1
/// to be scalars encoded in the format expected by TVM `BLS_G1_MULTIEXP`.
@pure
fun ArkVerifier.blsG1Multiexp1(
  x1: slice, y1: int,
  n: int
): slice asm "BLS_G1_MULTIEXP";


// Internal messages carry public inputs as a custom payload:
// uint8 length, then canonical three-int257 chunks chained through refs.
fun ArkVerifier.checkPublicInputsPayloadShape(payload: slice) {
  var remaining: int = 1;

  while (remaining > 0) {
    var chunk: int = remaining;
    if (chunk > 3) { chunk = 3; }
    if (payload.remainingBitsCount() != chunk * 257) { throw ArkVerifierErrors.InvalidInputs; }
    remaining -= chunk;

    if (remaining > 0) {
      if (payload.remainingRefsCount() != 1) { throw ArkVerifierErrors.InvalidInputs; }
      val (nextPayload, isExotic) = payload.loadRef().beginParseSpecial();
      if (isExotic) { throw ArkVerifierErrors.InvalidInputs; }
      payload = nextPayload;
    } else if (payload.remainingRefsCount() != 0) {
      throw ArkVerifierErrors.InvalidInputs;
    }
  }
}

fun ArkVerifier.loadNextPubInput(mutate payload: slice): int {
  if (payload.remainingBitsCount() < 257) {
    if (payload.remainingBitsCount() != 0 || payload.remainingRefsCount() != 1) {
      throw ArkVerifierErrors.InvalidInputs;
    }
    val (nextPayload, isExotic) = payload.loadRef().beginParseSpecial();
    if (isExotic || nextPayload.remainingBitsCount() < 257) {
      throw ArkVerifierErrors.InvalidInputs;
    }
    payload = nextPayload;
  }
  return ArkVerifier.checkPublicInput(payload.loadInt(257));
}

fun ArkVerifier.finishGroth16(
  self,
  piA: slice,
  piB: slice,
  piC: slice,
  acc: slice,
  haveAcc: bool
): bool {
  // Final cpub = IC0 + acc (IC0 is always added exactly once)
  var cpub: slice;
  if (!haveAcc) {
    cpub = self.ic0;
  } else {
    cpub = ArkVerifier.blsG1Add(acc, self.ic0);
  }

  // Pairing check: e(cpub, gamma) * e(-piA, piB) * e(piC, delta) * e(alpha, beta) == 1
  val piANeg: slice = ArkVerifier.blsG1Neg(piA);
  val ok: int = ArkVerifier.blsPairing(
    cpub,         self.vkGamma2,
    piANeg,       piB,
    piC,          self.vkDelta2,
    self.vkAlpha1, self.vkBeta2,
    4
  );

  return ok != 0;
}

fun ArkVerifier.verifyPayload(
  self,
  piA: slice,
  piB: slice,
  piC: slice,
  mutate payload: slice
): bool {
  ArkVerifier.checkProofPoints(piA, piB, piC);

  // Compute: cpub = IC0 + sum(pubInputs[i] * IC(i+1))
  var haveAcc: bool = false;
  var acc: slice = self.ic0; // placeholder until haveAcc == true

  val y1: int = ArkVerifier.loadNextPubInput(mutate payload);
  acc = ArkVerifier.blsG1Multiexp1(
    self.ic1, y1
    , 1
  );
  haveAcc = true;

  if (payload.remainingBitsCount() != 0 || payload.remainingRefsCount() != 0) {
    throw ArkVerifierErrors.InvalidInputs;
  }

  return self.finishGroth16(piA, piB, piC, acc, haveAcc);
}

fun ArkVerifier.verify(self, piA: slice, piB: slice, piC: slice, pubInputs: array<int>): bool {
  ArkVerifier.checkProofPoints(piA, piB, piC);
  if (pubInputs.size() != self.nPublic) { throw ArkVerifierErrors.InvalidInputs; }

  // Compute: cpub = IC0 + sum(pubInputs[i] * IC(i+1))
  var haveAcc: bool = false;
  var acc: slice = self.ic0; // placeholder until haveAcc == true

  acc = ArkVerifier.blsG1Multiexp1(
    self.ic1, ArkVerifier.checkPublicInput(pubInputs.get(0))
    , 1
  );
  haveAcc = true;

  return self.finishGroth16(piA, piB, piC, acc, haveAcc);
}

/// Internal message containing Groth16 proof points and serialized public inputs.
struct (0x3b3cca17) ArkVerifierVerify {
  /// Ordinary cell with exactly three refs: piA, piB, piC.
  proof: cell
  /// Ordinary cell with uint8 length followed by a linear int257 ref chain.
  pubInputs: cell
}

fun ArkVerifier.verifyProof(self, msg: ArkVerifierVerify): bool {
  val (piA, piB, piC) = ArkVerifier.loadCheckedProof(msg.proof);
  val (initialPayload, payloadIsExotic) = msg.pubInputs.beginParseSpecial();
  var payload = initialPayload;

  if (payloadIsExotic || payload.remainingBitsCount() < 8) { throw ArkVerifierErrors.InvalidInputs; }
  if (payload.loadUint(8) != self.nPublic) { throw ArkVerifierErrors.InvalidInputs; }
  ArkVerifier.checkPublicInputsPayloadShape(payload);

  return self.verifyPayload(piA, piB, piC, mutate payload);
}

// Convenience standalone entrypoints. Remove or rename them when composing
// multiple verifier structs inside one contract.
fun onInternalMessage(inMsg: InMessage) {
  val msg = lazy ArkVerifierVerify.fromSlice(inMsg.body);

  match (msg) {
    ArkVerifierVerify => {
      assert (inMsg.valueCoins >= ArkVerifierMinVerifyValue) throw ArkVerifierErrors.NotEnoughValue;
      val messageTail = msg.forceLoadLazyObject();
      if (!messageTail.isEmpty()) { throw ArkVerifierErrors.InvalidInputs; }
      assert (ArkVerifier.create().verifyProof(msg)) throw ArkVerifierErrors.WrongProof;
    }
    else => {
      assert (inMsg.body.isEmpty()) throw ArkVerifierErrors.InvalidInputs;
    }
  }
}


/// Verifies a Groth16 proof against public inputs.
get fun verify_ArkVerifier(piA: slice, piB: slice, piC: slice, pubInputs: array<int>): bool {
  return ArkVerifier.create().verify(piA, piB, piC, pubInputs);
}
