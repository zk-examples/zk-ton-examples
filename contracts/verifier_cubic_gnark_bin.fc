
#include "imports/stdlib.fc";

;; ops
const op::verify = "op::verify"c;

;; input constants (IC0 is the base term)
const slice verifier::IC0 = "947371f0313152314b2c6c9643399f5a81927f526eecc67db2aed5f3d8c729e7d8749724703d129b761419a323ed0a94"s;
const slice verifier::IC1 = "b29d7a599d77e8432b32cb7b4c631afe64156ed598c213c5cc4ef2a0750ec1b3854aa157df72a7fa98ff1ebf41f09de3"s;

;; vk constants
const slice verifier::vk_gamma_2 = "ad72d0ac89c1b44a46a41a9077a9507da193cbc2abcf574a6242ede7c47089d390efecd9f2b6cf331c52b2958c88c1700f892e10709cca8dd1b6b32f0a1b20d8f275797b6332983425a1854003a7a20e51f30725828f9b68002066da2ae6e95b"s;
const slice verifier::vk_delta_2 = "87e6d6b01f25ad6363303f24e964705526e57843bdf5acba6d0319b63d2d827c7beefa79a58ba606c6e004e71f17c249004901dbd826e742e4d9dd87478a7adbc5c7758b42303950b2633bb031fde6a76f2fc2ed4e8f53308eb16e13716c0808"s;
const slice verifier::vk_alpha_1 = "a24ba174055757ecc604d39bab36d2f33a6564519e3b7d004974b593ad14d988cae28e223876bf54f147bafbc9dbbf4f"s;
const slice verifier::vk_beta_2  = "a1134ed31cf09f0520c5d817b4a319ab7af4bc3035c8b40d8d1fba10d898f7b12cb39717e968b8d1aece11a2094e19360bf0d34a6654223090f7ade6c0c38f7e4afd67ddb1f8b83d48d5ede8a57dd882a575245cc971b8d18709e948d9258909"s;

;; public input dict settings
const int verifier::publicInputKeyLen = 32;
const int verifier::nPublic = 1;

;; error codes
const int verifier::err::public_not_present = 257;
const int verifier::err::too_many_publics = 258;
const int verifier::err::wrong_proof = 260;

;; bls intrinsics
slice bls_g1_add(slice x, slice y) asm "BLS_G1_ADD";
slice bls_g1_neg(slice x) asm "BLS_G1_NEG";
int bls_pairing(slice x1, slice y1, slice x2, slice y2, slice x3, slice y3, slice x4, slice y4, int n) asm "BLS_PAIRING";

slice bls_g1_multiexp_1(
    slice x1, int y1
    , int n
) asm "BLS_G1_MULTIEXP";

(int) groth16Verify(
    slice piA,
    slice piB,
    slice piC,
    cell pubInputs
) impure {

    ;; extract public inputs by keys 0..nPublic-1
    (slice input0, int ok0) = pubInputs~udict_delete_get?(verifier::publicInputKeyLen, 0);
    throw_unless(verifier::err::public_not_present, ok0);
    int val0 = input0~load_uint(256);

    ;; ensure the dict is now empty (no extra public inputs beyond 0..nPublic-1)
    throw_unless(verifier::err::too_many_publics, null?(pubInputs));

    ;; assemble cpub via batched MULTIEXP and summation
    slice cpub = bls_g1_multiexp_1(
        verifier::IC1, val0
        , 1
    );

    ;; add the free term IC0
    cpub = bls_g1_add(cpub, verifier::IC0);

    ;; pairing check
    slice piA_neg = bls_g1_neg(piA);
    int a = bls_pairing(
        cpub,              verifier::vk_gamma_2,
        piA_neg,          piB,
        piC,              verifier::vk_delta_2,
        verifier::vk_alpha_1, verifier::vk_beta_2,
        4
    );

    return (0 - (a != 0));
}

(int) verifyProof(
    slice in_msg_body
) impure {
    slice piA = in_msg_body~load_ref().begin_parse();
    slice piB = in_msg_body~load_ref().begin_parse();
    slice piC = in_msg_body~load_ref().begin_parse();
    var pubInputs = in_msg_body~load_dict();

    return groth16Verify(
        piA,
        piB,
        piC,
        pubInputs
    );
}

() recv_internal(cell in_msg_full, slice in_msg_body) impure {
    if (in_msg_body.slice_empty?()) {
        return ();
    }
    slice cs = in_msg_full.begin_parse();
    int flags = cs~load_uint(4);
    if (flags & 1) {
        return ();
    }
    int op = in_msg_body~load_uint(32);

    if (op == op::verify) {
        throw_unless(verifier::err::wrong_proof, verifyProof(in_msg_body));
        return ();
    }
    throw(0xffff);
}

int verify(slice piA, slice piB, slice piC, slice pubInputs) method_id {
  return groth16Verify(piA, piB, piC, pubInputs~load_dict());
}
