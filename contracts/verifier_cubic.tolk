
import "@stdlib/exotic-cells"

contract Cubic {
  description: "Groth16 verifier generated by export-ton-verifier"
  storage: CubicStorage
  incomingMessages: CubicVerify
}

/// This verifier is stateless.
/// It does not provide:
/// - nullifier replay protection;
/// - nonce or query-id protection;
/// - known-root validation;
/// - recipient binding;
/// - chain-id or contract-address domain separation;
/// - state-transition validation.

/// Empty persistent storage; verifier constants are embedded in code.
struct CubicStorage {}

struct Cubic {
  ic0: slice
  ic1: slice
  vkGamma2: slice
  vkDelta2: slice
  vkAlpha1: slice
  vkBeta2: slice
  nPublic: int
}

const CubicMinVerifyValue: coins = 50000000

enum CubicErrors {
  InvalidInputs = 258,
  WrongProof = 260,
  NotEnoughValue = 261,
}

fun Cubic.create(): Cubic {
  return Cubic {
    ic0: "947371f0313152314b2c6c9643399f5a81927f526eecc67db2aed5f3d8c729e7d8749724703d129b761419a323ed0a94".hexToSlice(),
    ic1: "b29d7a599d77e8432b32cb7b4c631afe64156ed598c213c5cc4ef2a0750ec1b3854aa157df72a7fa98ff1ebf41f09de3".hexToSlice(),
    vkGamma2: "ad72d0ac89c1b44a46a41a9077a9507da193cbc2abcf574a6242ede7c47089d390efecd9f2b6cf331c52b2958c88c1700f892e10709cca8dd1b6b32f0a1b20d8f275797b6332983425a1854003a7a20e51f30725828f9b68002066da2ae6e95b".hexToSlice(),
    vkDelta2: "87e6d6b01f25ad6363303f24e964705526e57843bdf5acba6d0319b63d2d827c7beefa79a58ba606c6e004e71f17c249004901dbd826e742e4d9dd87478a7adbc5c7758b42303950b2633bb031fde6a76f2fc2ed4e8f53308eb16e13716c0808".hexToSlice(),
    vkAlpha1: "a24ba174055757ecc604d39bab36d2f33a6564519e3b7d004974b593ad14d988cae28e223876bf54f147bafbc9dbbf4f".hexToSlice(),
    vkBeta2: "a1134ed31cf09f0520c5d817b4a319ab7af4bc3035c8b40d8d1fba10d898f7b12cb39717e968b8d1aece11a2094e19360bf0d34a6654223090f7ade6c0c38f7e4afd67ddb1f8b83d48d5ede8a57dd882a575245cc971b8d18709e948d9258909".hexToSlice(),
    nPublic: 1,
  };
}

/// # Safety
/// Expects both slices to contain canonically encoded BLS12-381 G1 points
/// accepted by the TVM `BLS_G1_ADD` opcode.
@pure fun Cubic.blsG1Add(x: slice, y: slice): slice asm "BLS_G1_ADD";

/// # Safety
/// Expects the slice to contain a canonically encoded BLS12-381 G1 point
/// accepted by the TVM `BLS_G1_NEG` opcode.
@pure fun Cubic.blsG1Neg(x: slice): slice asm "BLS_G1_NEG";

@pure fun Cubic.blsG1InGroup(x: slice): bool asm "BLS_G1_INGROUP";
@pure fun Cubic.blsG2InGroup(x: slice): bool asm "BLS_G2_INGROUP";
@pure fun Cubic.blsG1IsZero(x: slice): bool asm "BLS_G1_ISZERO";
@pure fun Cubic.blsG2IsZero(x: slice): bool asm "BLS_G2_ISZERO";

fun Cubic.checkProofPoints(piA: slice, piB: slice, piC: slice) {
  if (
    piA.remainingBitsCount() != 384 || piA.remainingRefsCount() != 0 ||
    piB.remainingBitsCount() != 768 || piB.remainingRefsCount() != 0 ||
    piC.remainingBitsCount() != 384 || piC.remainingRefsCount() != 0
  ) {
    throw CubicErrors.InvalidInputs;
  }
  if (!Cubic.blsG1InGroup(piA) || !Cubic.blsG2InGroup(piB) || !Cubic.blsG1InGroup(piC)) {
    throw CubicErrors.InvalidInputs;
  }
  if (Cubic.blsG1IsZero(piA) || Cubic.blsG2IsZero(piB) || Cubic.blsG1IsZero(piC)) {
    throw CubicErrors.InvalidInputs;
  }
}

fun Cubic.loadCheckedG1(point: cell): slice {
  val (pointSlice, isExotic) = point.beginParseSpecial();
  if (isExotic || pointSlice.remainingBitsCount() != 384 || pointSlice.remainingRefsCount() != 0) {
    throw CubicErrors.InvalidInputs;
  }
  return pointSlice;
}

fun Cubic.loadCheckedG2(point: cell): slice {
  val (pointSlice, isExotic) = point.beginParseSpecial();
  if (isExotic || pointSlice.remainingBitsCount() != 768 || pointSlice.remainingRefsCount() != 0) {
    throw CubicErrors.InvalidInputs;
  }
  return pointSlice;
}

fun Cubic.loadCheckedProof(proof: cell): (slice, slice, slice) {
  val (initialProof, isExotic) = proof.beginParseSpecial();
  var proofSlice = initialProof;
  if (isExotic || proofSlice.remainingBitsCount() != 0 || proofSlice.remainingRefsCount() != 3) {
    throw CubicErrors.InvalidInputs;
  }
  val piA = Cubic.loadCheckedG1(proofSlice.loadRef());
  val piB = Cubic.loadCheckedG2(proofSlice.loadRef());
  val piC = Cubic.loadCheckedG1(proofSlice.loadRef());
  proofSlice.assertEnd();
  return (piA, piB, piC);
}

@pure fun Cubic.blsR(): int asm "BLS_PUSHR";

fun Cubic.checkPublicInput(x: int): int {
  // TVM scalar multiplication reduces modulo r, so x and x+r would otherwise alias.
  if (x < 0 || x >= Cubic.blsR()) {
    throw CubicErrors.InvalidInputs;
  }
  return x;
}

/// # Safety
/// Expects the provided slices to contain canonically encoded BLS12-381 proof
/// and verification-key points in the order required by TVM `BLS_PAIRING`.
@pure fun Cubic.blsPairing(
  x1: slice, y1: slice,
  x2: slice, y2: slice,
  x3: slice, y3: slice,
  x4: slice, y4: slice,
  n: int
): int asm "BLS_PAIRING";

/// # Safety
/// Expects x1..x1 to be canonical BLS12-381 G1 points and y1..y1
/// to be scalars encoded in the format expected by TVM `BLS_G1_MULTIEXP`.
@pure
fun Cubic.blsG1Multiexp1(
  x1: slice, y1: int,
  n: int
): slice asm "BLS_G1_MULTIEXP";


// Internal messages carry public inputs as a custom payload:
// uint8 length, then canonical three-int257 chunks chained through refs.
fun Cubic.checkPublicInputsPayloadShape(payload: slice) {
  var remaining: int = 1;

  while (remaining > 0) {
    var chunk: int = remaining;
    if (chunk > 3) { chunk = 3; }
    if (payload.remainingBitsCount() != chunk * 257) { throw CubicErrors.InvalidInputs; }
    remaining -= chunk;

    if (remaining > 0) {
      if (payload.remainingRefsCount() != 1) { throw CubicErrors.InvalidInputs; }
      val (nextPayload, isExotic) = payload.loadRef().beginParseSpecial();
      if (isExotic) { throw CubicErrors.InvalidInputs; }
      payload = nextPayload;
    } else if (payload.remainingRefsCount() != 0) {
      throw CubicErrors.InvalidInputs;
    }
  }
}

fun Cubic.loadNextPubInput(mutate payload: slice): int {
  if (payload.remainingBitsCount() < 257) {
    if (payload.remainingBitsCount() != 0 || payload.remainingRefsCount() != 1) {
      throw CubicErrors.InvalidInputs;
    }
    val (nextPayload, isExotic) = payload.loadRef().beginParseSpecial();
    if (isExotic || nextPayload.remainingBitsCount() < 257) {
      throw CubicErrors.InvalidInputs;
    }
    payload = nextPayload;
  }
  return Cubic.checkPublicInput(payload.loadInt(257));
}

fun Cubic.finishGroth16(
  self,
  piA: slice,
  piB: slice,
  piC: slice,
  acc: slice,
  haveAcc: bool
): bool {
  // Final cpub = IC0 + acc (IC0 is always added exactly once)
  var cpub: slice;
  if (!haveAcc) {
    cpub = self.ic0;
  } else {
    cpub = Cubic.blsG1Add(acc, self.ic0);
  }

  // Pairing check: e(cpub, gamma) * e(-piA, piB) * e(piC, delta) * e(alpha, beta) == 1
  val piANeg: slice = Cubic.blsG1Neg(piA);
  val ok: int = Cubic.blsPairing(
    cpub,         self.vkGamma2,
    piANeg,       piB,
    piC,          self.vkDelta2,
    self.vkAlpha1, self.vkBeta2,
    4
  );

  return ok != 0;
}

fun Cubic.verifyPayload(
  self,
  piA: slice,
  piB: slice,
  piC: slice,
  mutate payload: slice
): bool {
  Cubic.checkProofPoints(piA, piB, piC);

  // Compute: cpub = IC0 + sum(pubInputs[i] * IC(i+1))
  var haveAcc: bool = false;
  var acc: slice = self.ic0; // placeholder until haveAcc == true

  val y1: int = Cubic.loadNextPubInput(mutate payload);
  acc = Cubic.blsG1Multiexp1(
    self.ic1, y1
    , 1
  );
  haveAcc = true;

  if (payload.remainingBitsCount() != 0 || payload.remainingRefsCount() != 0) {
    throw CubicErrors.InvalidInputs;
  }

  return self.finishGroth16(piA, piB, piC, acc, haveAcc);
}

fun Cubic.verify(self, piA: slice, piB: slice, piC: slice, pubInputs: array<int>): bool {
  Cubic.checkProofPoints(piA, piB, piC);
  if (pubInputs.size() != self.nPublic) { throw CubicErrors.InvalidInputs; }

  // Compute: cpub = IC0 + sum(pubInputs[i] * IC(i+1))
  var haveAcc: bool = false;
  var acc: slice = self.ic0; // placeholder until haveAcc == true

  acc = Cubic.blsG1Multiexp1(
    self.ic1, Cubic.checkPublicInput(pubInputs.get(0))
    , 1
  );
  haveAcc = true;

  return self.finishGroth16(piA, piB, piC, acc, haveAcc);
}

/// Internal message containing Groth16 proof points and serialized public inputs.
struct (0x3b3cca17) CubicVerify {
  /// Ordinary cell with exactly three refs: piA, piB, piC.
  proof: cell
  /// Ordinary cell with uint8 length followed by a linear int257 ref chain.
  pubInputs: cell
}

fun Cubic.verifyProof(self, msg: CubicVerify): bool {
  val (piA, piB, piC) = Cubic.loadCheckedProof(msg.proof);
  val (initialPayload, payloadIsExotic) = msg.pubInputs.beginParseSpecial();
  var payload = initialPayload;

  if (payloadIsExotic || payload.remainingBitsCount() < 8) { throw CubicErrors.InvalidInputs; }
  if (payload.loadUint(8) != self.nPublic) { throw CubicErrors.InvalidInputs; }
  Cubic.checkPublicInputsPayloadShape(payload);

  return self.verifyPayload(piA, piB, piC, mutate payload);
}

// Convenience standalone entrypoints. Remove or rename them when composing
// multiple verifier structs inside one contract.
fun onInternalMessage(inMsg: InMessage) {
  val msg = lazy CubicVerify.fromSlice(inMsg.body);

  match (msg) {
    CubicVerify => {
      assert (inMsg.valueCoins >= CubicMinVerifyValue) throw CubicErrors.NotEnoughValue;
      val messageTail = msg.forceLoadLazyObject();
      if (!messageTail.isEmpty()) { throw CubicErrors.InvalidInputs; }
      assert (Cubic.create().verifyProof(msg)) throw CubicErrors.WrongProof;
    }
    else => {
      assert (inMsg.body.isEmpty()) throw CubicErrors.InvalidInputs;
    }
  }
}


/// Verifies a Groth16 proof against public inputs.
get fun verify_Cubic(piA: slice, piB: slice, piC: slice, pubInputs: array<int>): bool {
  return Cubic.create().verify(piA, piB, piC, pubInputs);
}
