const VK_ALPHA_1: slice = "8be4fc24dcc420432f0d3d85457acaa7e7015fcb7b37b0742b7397694672a6a7b6cc64531a8ff08c91b8f297aa016a37".hexToSlice()
const VK_BETA_2:  slice = "85ad47cf25222ba7131730347722d8b7be38e8bbf49a7fd9e496541d4356dd51c71d0b80ac9f14f4e594f046776fd7790d7cfdcb8c702635290b0cb42fd4f0f40ae4ca23881df3f89a61c9f7b188efbcb89769c4f133a5a75b2f141ba38e22e2".hexToSlice()

const N_PUBLIC: int = 81

enum VerifierErrors {
  InvalidInputs = 258,
  IndexOutOfRange = 259,
  WrongProof = 260,
}


/// # Safety
/// Expects both slices to contain canonically encoded BLS12-381 G1 points
/// accepted by the TVM `BLS_G1_ADD` opcode.
@pure fun blsG1Add(x: slice, y: slice): slice asm "BLS_G1_ADD";

/// # Safety
/// Expects the slice to contain a canonically encoded BLS12-381 G1 point
/// accepted by the TVM `BLS_G1_NEG` opcode.
@pure fun blsG1Neg(x: slice): slice asm "BLS_G1_NEG";

/// # Safety
/// Expects the provided slices to contain canonically encoded BLS12-381 proof
/// and verification-key points in the order required by TVM `BLS_PAIRING`.
@pure fun blsPairing(
  x1: slice, y1: slice,
  x2: slice, y2: slice,
  x3: slice, y3: slice,
  x4: slice, y4: slice,
  n: int
): int asm "BLS_PAIRING";

/// # Safety
/// Expects x1..x7 to be canonical BLS12-381 G1 points and y1..y7
/// to be scalars encoded in the format expected by TVM `BLS_G1_MULTIEXP`.
@pure
fun blsG1Multiexp7(
  x1: slice, y1: int,
  x2: slice, y2: int,
  x3: slice, y3: int,
  x4: slice, y4: int,
  x5: slice, y5: int,
  x6: slice, y6: int,
  x7: slice, y7: int,
  n: int
): slice asm "BLS_G1_MULTIEXP";

/// # Safety
/// Expects x1..x4 to be canonical BLS12-381 G1 points and y1..y4
/// to be scalars encoded in the format expected by TVM `BLS_G1_MULTIEXP`.
@pure
fun blsG1Multiexp4(
  x1: slice, y1: int,
  x2: slice, y2: int,
  x3: slice, y3: int,
  x4: slice, y4: int,
  n: int
): slice asm "BLS_G1_MULTIEXP";

