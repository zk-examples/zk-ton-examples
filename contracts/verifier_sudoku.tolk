  if (idx == 79) { return "8bfd1745e189a1450f423de26012423b34992a0e2fe34afbd4f33bd963f0bd7acd1463f36d9d092bea2d86ddad28e983".hexToSlice(); }
  if (idx == 80) { return "8f7dc9c515ad1981ee6eedf624dc42772bcd1dd3684bcc3c699488ed18ab2f5a843ccb830e78259275717de03d012fa1".hexToSlice(); }
  if (idx == 81) { return "b9dc71ecd3fa82ed0ba841e3d57d98881e1e2e1348bfa55ef8b1943b1dfbec2ebb9510f9215be4a71b1241f9d076adb7".hexToSlice(); }
  throw VerifierErrors.IndexOutOfRange;
}

// Internal messages carry public inputs as a custom payload:
// uint8 length, then canonical three-int257 chunks chained through refs.
fun checkPublicInputsPayloadShape(payload: slice) {
  var remaining: int = 81;

  while (remaining > 0) {
    var chunk: int = remaining;
    if (chunk > 3) { chunk = 3; }
    if (payload.remainingBitsCount() != chunk * 257) { throw VerifierErrors.InvalidInputs; }
    remaining -= chunk;

    if (remaining > 0) {
      if (payload.remainingRefsCount() != 1) { throw VerifierErrors.InvalidInputs; }
      val (nextPayload, isExotic) = payload.loadRef().beginParseSpecial();
      if (isExotic) { throw VerifierErrors.InvalidInputs; }
      payload = nextPayload;
    } else if (payload.remainingRefsCount() != 0) {
      throw VerifierErrors.InvalidInputs;
    }
  }
}

fun loadNextPubInput(mutate payload: slice): int {
  if (payload.remainingBitsCount() < 257) {
    if (payload.remainingBitsCount() != 0 || payload.remainingRefsCount() != 1) {
      throw VerifierErrors.InvalidInputs;
    }
    val (nextPayload, isExotic) = payload.loadRef().beginParseSpecial();
    if (isExotic || nextPayload.remainingBitsCount() < 257) {
      throw VerifierErrors.InvalidInputs;
    }
    payload = nextPayload;
  }
  return checkPublicInput(payload.loadInt(257));
}

fun finishGroth16(
  piA: slice,
  piB: slice,
  piC: slice,
  acc: slice,
  haveAcc: bool
): bool {
  // Final cpub = IC0 + acc (IC0 is always added exactly once)
  var cpub: slice;
  if (!haveAcc) {
    cpub = IC0;
  } else {
    cpub = blsG1Add(acc, IC0);
  }

  // Pairing check: e(cpub, gamma) * e(-piA, piB) * e(piC, delta) * e(alpha, beta) == 1
  val piANeg: slice = blsG1Neg(piA);
  val ok: int = blsPairing(
    cpub,         VK_GAMMA_2,
    piANeg,       piB,
    piC,          VK_DELTA_2,
    VK_ALPHA_1, VK_BETA_2,
    4
  );

  return ok != 0;
}

fun groth16VerifyPayload(
  piA: slice,
  piB: slice,
  piC: slice,
  mutate payload: slice
): bool {
  checkProofPoints(piA, piB, piC);

  // Compute: cpub = IC0 + sum(pubInputs[i] * IC(i+1))
  var haveAcc: bool = false;
  var acc: slice = IC0; // placeholder until haveAcc == true

  // Multiple 7-sized batches plus an optional tail.
  var done: int = 0;
  val full: int = N_PUBLIC / 7;
  val rem:  int = N_PUBLIC % 7;

  while (done < full * 7) {
    val y1: int = loadNextPubInput(mutate payload);
    val y2: int = loadNextPubInput(mutate payload);
    val y3: int = loadNextPubInput(mutate payload);
    val y4: int = loadNextPubInput(mutate payload);
    val y5: int = loadNextPubInput(mutate payload);
    val y6: int = loadNextPubInput(mutate payload);
    val y7: int = loadNextPubInput(mutate payload);
    val tmp: slice = blsG1Multiexp7(
      ic(done + 1), y1,
      ic(done + 2), y2,
      ic(done + 3), y3,
      ic(done + 4), y4,
      ic(done + 5), y5,
      ic(done + 6), y6,
      ic(done + 7), y7
      , 7
    );

    if (!haveAcc) {
      acc = tmp;
      haveAcc = true;
    } else {
      acc = blsG1Add(acc, tmp);
    }

    done += 7;
  }

  if (rem == 4) {
    val y1: int = loadNextPubInput(mutate payload);
    val y2: int = loadNextPubInput(mutate payload);
    val y3: int = loadNextPubInput(mutate payload);
    val y4: int = loadNextPubInput(mutate payload);
    val tail: slice = blsG1Multiexp4(
      ic(done + 1), y1,
      ic(done + 2), y2,
      ic(done + 3), y3,
      ic(done + 4), y4
      , 4
    );

    if (!haveAcc) {
      acc = tail;
      haveAcc = true;
    } else {
      acc = blsG1Add(acc, tail);
    }

    done += 4;
  }

  if (payload.remainingBitsCount() != 0 || payload.remainingRefsCount() != 0) {
    throw VerifierErrors.InvalidInputs;
  }

  return finishGroth16(piA, piB, piC, acc, haveAcc);
}

fun groth16VerifyArray(piA: slice, piB: slice, piC: slice, pubInputs: array<int>): bool {
  checkProofPoints(piA, piB, piC);
  if (pubInputs.size() != N_PUBLIC) { throw VerifierErrors.InvalidInputs; }

  // Compute: cpub = IC0 + sum(pubInputs[i] * IC(i+1))
  var haveAcc: bool = false;
  var acc: slice = IC0; // placeholder until haveAcc == true

  // Multiple 7-sized batches plus an optional tail.
  var done: int = 0;
  val full: int = N_PUBLIC / 7;
  val rem:  int = N_PUBLIC % 7;

  while (done < full * 7) {
    val tmp: slice = blsG1Multiexp7(
      ic(done + 1), checkPublicInput(pubInputs.get(done)),
      ic(done + 2), checkPublicInput(pubInputs.get(done + 1)),
      ic(done + 3), checkPublicInput(pubInputs.get(done + 2)),
      ic(done + 4), checkPublicInput(pubInputs.get(done + 3)),
      ic(done + 5), checkPublicInput(pubInputs.get(done + 4)),
      ic(done + 6), checkPublicInput(pubInputs.get(done + 5)),
      ic(done + 7), checkPublicInput(pubInputs.get(done + 6))
      , 7
    );

    if (!haveAcc) {
      acc = tmp;
      haveAcc = true;
    } else {
      acc = blsG1Add(acc, tmp);
    }

    done += 7;
  }

  if (rem == 4) {
    val tail: slice = blsG1Multiexp4(
      ic(done + 1), checkPublicInput(pubInputs.get(done)),
      ic(done + 2), checkPublicInput(pubInputs.get(done + 1)),
      ic(done + 3), checkPublicInput(pubInputs.get(done + 2)),
      ic(done + 4), checkPublicInput(pubInputs.get(done + 3))
      , 4
    );

    if (!haveAcc) {
      acc = tail;
      haveAcc = true;
    } else {
      acc = blsG1Add(acc, tail);
    }

    done += 4;
  }

  return finishGroth16(piA, piB, piC, acc, haveAcc);
}

/// Internal message containing Groth16 proof points and serialized public inputs.
struct (0x3b3cca17) Verify {
  /// Ordinary cell with exactly three refs: piA, piB, piC.
  proof: cell
  /// Ordinary cell with uint8 length followed by a linear int257 ref chain.
  pubInputs: cell
}

fun verifyProof(msg: Verify): bool {
  val (piA, piB, piC) = loadCheckedProof(msg.proof);
  val (initialPayload, payloadIsExotic) = msg.pubInputs.beginParseSpecial();
  var payload = initialPayload;

  if (payloadIsExotic || payload.remainingBitsCount() < 8) { throw VerifierErrors.InvalidInputs; }
  if (payload.loadUint(8) != N_PUBLIC) { throw VerifierErrors.InvalidInputs; }
  checkPublicInputsPayloadShape(payload);

  return groth16VerifyPayload(piA, piB, piC, mutate payload);
}

fun onInternalMessage(inMsg: InMessage) {
  val msg = lazy Verify.fromSlice(inMsg.body);

  match (msg) {
    Verify => {
      assert (inMsg.valueCoins >= MIN_VERIFY_VALUE) throw VerifierErrors.NotEnoughValue;
      val messageTail = msg.forceLoadLazyObject();
      if (!messageTail.isEmpty()) { throw VerifierErrors.InvalidInputs; }
      assert (verifyProof(msg)) throw VerifierErrors.WrongProof;
    }
    else => {
      assert (inMsg.body.isEmpty()) throw VerifierErrors.InvalidInputs;
    }
  }
}

/// Verifies a Groth16 proof against public inputs.
get fun verify(piA: slice, piB: slice, piC: slice, pubInputs: array<int>): bool {
  return groth16VerifyArray(piA, piB, piC, pubInputs);
}

