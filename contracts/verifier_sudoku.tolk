  pubInput58: int,
  pubInput59: int,
  pubInput60: int,
  pubInput61: int,
  pubInput62: int,
  pubInput63: int,
  pubInput64: int,
  pubInput65: int,
  pubInput66: int,
  pubInput67: int,
  pubInput68: int,
  pubInput69: int,
  pubInput70: int,
  pubInput71: int,
  pubInput72: int,
  pubInput73: int,
  pubInput74: int,
