): bool {
  // Compute: cpub = IC0 + sum(pubInputs[i] * IC(i+1))
  var haveAcc: bool = false;
  var acc: slice = IC0; // placeholder until haveAcc == true

  // Multiple 7-sized batches plus an optional tail.
  var done: int = 0;
  var full: int = N_PUBLIC / 7;
  var rem:  int = N_PUBLIC % 7;

  while (full > 0) {
    var tmp: slice = blsG1Multiexp_7(
      ic(done + 1), pubInputAt(done + 0, pubInput0, pubInput1, pubInput2, pubInput3, pubInput4, pubInput5, pubInput6, pubInput7, pubInput8, pubInput9, pubInput10, pubInput11, pubInput12, pubInput13, pubInput14, pubInput15, pubInput16, pubInput17, pubInput18, pubInput19, pubInput20, pubInput21, pubInput22, pubInput23, pubInput24, pubInput25, pubInput26, pubInput27, pubInput28, pubInput29, pubInput30, pubInput31, pubInput32, pubInput33, pubInput34, pubInput35, pubInput36, pubInput37, pubInput38, pubInput39, pubInput40, pubInput41, pubInput42, pubInput43, pubInput44, pubInput45, pubInput46, pubInput47, pubInput48, pubInput49, pubInput50, pubInput51, pubInput52, pubInput53, pubInput54, pubInput55, pubInput56, pubInput57, pubInput58, pubInput59, pubInput60, pubInput61, pubInput62, pubInput63, pubInput64, pubInput65, pubInput66, pubInput67, pubInput68, pubInput69, pubInput70, pubInput71, pubInput72, pubInput73, pubInput74, pubInput75, pubInput76, pubInput77, pubInput78, pubInput79, pubInput80),
      ic(done + 2), pubInputAt(done + 1, pubInput0, pubInput1, pubInput2, pubInput3, pubInput4, pubInput5, pubInput6, pubInput7, pubInput8, pubInput9, pubInput10, pubInput11, pubInput12, pubInput13, pubInput14, pubInput15, pubInput16, pubInput17, pubInput18, pubInput19, pubInput20, pubInput21, pubInput22, pubInput23, pubInput24, pubInput25, pubInput26, pubInput27, pubInput28, pubInput29, pubInput30, pubInput31, pubInput32, pubInput33, pubInput34, pubInput35, pubInput36, pubInput37, pubInput38, pubInput39, pubInput40, pubInput41, pubInput42, pubInput43, pubInput44, pubInput45, pubInput46, pubInput47, pubInput48, pubInput49, pubInput50, pubInput51, pubInput52, pubInput53, pubInput54, pubInput55, pubInput56, pubInput57, pubInput58, pubInput59, pubInput60, pubInput61, pubInput62, pubInput63, pubInput64, pubInput65, pubInput66, pubInput67, pubInput68, pubInput69, pubInput70, pubInput71, pubInput72, pubInput73, pubInput74, pubInput75, pubInput76, pubInput77, pubInput78, pubInput79, pubInput80),
      ic(done + 3), pubInputAt(done + 2, pubInput0, pubInput1, pubInput2, pubInput3, pubInput4, pubInput5, pubInput6, pubInput7, pubInput8, pubInput9, pubInput10, pubInput11, pubInput12, pubInput13, pubInput14, pubInput15, pubInput16, pubInput17, pubInput18, pubInput19, pubInput20, pubInput21, pubInput22, pubInput23, pubInput24, pubInput25, pubInput26, pubInput27, pubInput28, pubInput29, pubInput30, pubInput31, pubInput32, pubInput33, pubInput34, pubInput35, pubInput36, pubInput37, pubInput38, pubInput39, pubInput40, pubInput41, pubInput42, pubInput43, pubInput44, pubInput45, pubInput46, pubInput47, pubInput48, pubInput49, pubInput50, pubInput51, pubInput52, pubInput53, pubInput54, pubInput55, pubInput56, pubInput57, pubInput58, pubInput59, pubInput60, pubInput61, pubInput62, pubInput63, pubInput64, pubInput65, pubInput66, pubInput67, pubInput68, pubInput69, pubInput70, pubInput71, pubInput72, pubInput73, pubInput74, pubInput75, pubInput76, pubInput77, pubInput78, pubInput79, pubInput80),
      ic(done + 4), pubInputAt(done + 3, pubInput0, pubInput1, pubInput2, pubInput3, pubInput4, pubInput5, pubInput6, pubInput7, pubInput8, pubInput9, pubInput10, pubInput11, pubInput12, pubInput13, pubInput14, pubInput15, pubInput16, pubInput17, pubInput18, pubInput19, pubInput20, pubInput21, pubInput22, pubInput23, pubInput24, pubInput25, pubInput26, pubInput27, pubInput28, pubInput29, pubInput30, pubInput31, pubInput32, pubInput33, pubInput34, pubInput35, pubInput36, pubInput37, pubInput38, pubInput39, pubInput40, pubInput41, pubInput42, pubInput43, pubInput44, pubInput45, pubInput46, pubInput47, pubInput48, pubInput49, pubInput50, pubInput51, pubInput52, pubInput53, pubInput54, pubInput55, pubInput56, pubInput57, pubInput58, pubInput59, pubInput60, pubInput61, pubInput62, pubInput63, pubInput64, pubInput65, pubInput66, pubInput67, pubInput68, pubInput69, pubInput70, pubInput71, pubInput72, pubInput73, pubInput74, pubInput75, pubInput76, pubInput77, pubInput78, pubInput79, pubInput80),
      ic(done + 5), pubInputAt(done + 4, pubInput0, pubInput1, pubInput2, pubInput3, pubInput4, pubInput5, pubInput6, pubInput7, pubInput8, pubInput9, pubInput10, pubInput11, pubInput12, pubInput13, pubInput14, pubInput15, pubInput16, pubInput17, pubInput18, pubInput19, pubInput20, pubInput21, pubInput22, pubInput23, pubInput24, pubInput25, pubInput26, pubInput27, pubInput28, pubInput29, pubInput30, pubInput31, pubInput32, pubInput33, pubInput34, pubInput35, pubInput36, pubInput37, pubInput38, pubInput39, pubInput40, pubInput41, pubInput42, pubInput43, pubInput44, pubInput45, pubInput46, pubInput47, pubInput48, pubInput49, pubInput50, pubInput51, pubInput52, pubInput53, pubInput54, pubInput55, pubInput56, pubInput57, pubInput58, pubInput59, pubInput60, pubInput61, pubInput62, pubInput63, pubInput64, pubInput65, pubInput66, pubInput67, pubInput68, pubInput69, pubInput70, pubInput71, pubInput72, pubInput73, pubInput74, pubInput75, pubInput76, pubInput77, pubInput78, pubInput79, pubInput80),
      ic(done + 6), pubInputAt(done + 5, pubInput0, pubInput1, pubInput2, pubInput3, pubInput4, pubInput5, pubInput6, pubInput7, pubInput8, pubInput9, pubInput10, pubInput11, pubInput12, pubInput13, pubInput14, pubInput15, pubInput16, pubInput17, pubInput18, pubInput19, pubInput20, pubInput21, pubInput22, pubInput23, pubInput24, pubInput25, pubInput26, pubInput27, pubInput28, pubInput29, pubInput30, pubInput31, pubInput32, pubInput33, pubInput34, pubInput35, pubInput36, pubInput37, pubInput38, pubInput39, pubInput40, pubInput41, pubInput42, pubInput43, pubInput44, pubInput45, pubInput46, pubInput47, pubInput48, pubInput49, pubInput50, pubInput51, pubInput52, pubInput53, pubInput54, pubInput55, pubInput56, pubInput57, pubInput58, pubInput59, pubInput60, pubInput61, pubInput62, pubInput63, pubInput64, pubInput65, pubInput66, pubInput67, pubInput68, pubInput69, pubInput70, pubInput71, pubInput72, pubInput73, pubInput74, pubInput75, pubInput76, pubInput77, pubInput78, pubInput79, pubInput80),
      ic(done + 7), pubInputAt(done + 6, pubInput0, pubInput1, pubInput2, pubInput3, pubInput4, pubInput5, pubInput6, pubInput7, pubInput8, pubInput9, pubInput10, pubInput11, pubInput12, pubInput13, pubInput14, pubInput15, pubInput16, pubInput17, pubInput18, pubInput19, pubInput20, pubInput21, pubInput22, pubInput23, pubInput24, pubInput25, pubInput26, pubInput27, pubInput28, pubInput29, pubInput30, pubInput31, pubInput32, pubInput33, pubInput34, pubInput35, pubInput36, pubInput37, pubInput38, pubInput39, pubInput40, pubInput41, pubInput42, pubInput43, pubInput44, pubInput45, pubInput46, pubInput47, pubInput48, pubInput49, pubInput50, pubInput51, pubInput52, pubInput53, pubInput54, pubInput55, pubInput56, pubInput57, pubInput58, pubInput59, pubInput60, pubInput61, pubInput62, pubInput63, pubInput64, pubInput65, pubInput66, pubInput67, pubInput68, pubInput69, pubInput70, pubInput71, pubInput72, pubInput73, pubInput74, pubInput75, pubInput76, pubInput77, pubInput78, pubInput79, pubInput80)
      , 7
    );

    if (!haveAcc) {
      acc = tmp;
      haveAcc = true;
    } else {
      acc = blsG1Add(acc, tmp);
    }

    done += 7;
    full -= 1;
  }

  if (rem == 4) {
    var tail: slice = blsG1Multiexp_4(
      ic(done + 1), pubInputAt(done + 0, pubInput0, pubInput1, pubInput2, pubInput3, pubInput4, pubInput5, pubInput6, pubInput7, pubInput8, pubInput9, pubInput10, pubInput11, pubInput12, pubInput13, pubInput14, pubInput15, pubInput16, pubInput17, pubInput18, pubInput19, pubInput20, pubInput21, pubInput22, pubInput23, pubInput24, pubInput25, pubInput26, pubInput27, pubInput28, pubInput29, pubInput30, pubInput31, pubInput32, pubInput33, pubInput34, pubInput35, pubInput36, pubInput37, pubInput38, pubInput39, pubInput40, pubInput41, pubInput42, pubInput43, pubInput44, pubInput45, pubInput46, pubInput47, pubInput48, pubInput49, pubInput50, pubInput51, pubInput52, pubInput53, pubInput54, pubInput55, pubInput56, pubInput57, pubInput58, pubInput59, pubInput60, pubInput61, pubInput62, pubInput63, pubInput64, pubInput65, pubInput66, pubInput67, pubInput68, pubInput69, pubInput70, pubInput71, pubInput72, pubInput73, pubInput74, pubInput75, pubInput76, pubInput77, pubInput78, pubInput79, pubInput80),
      ic(done + 2), pubInputAt(done + 1, pubInput0, pubInput1, pubInput2, pubInput3, pubInput4, pubInput5, pubInput6, pubInput7, pubInput8, pubInput9, pubInput10, pubInput11, pubInput12, pubInput13, pubInput14, pubInput15, pubInput16, pubInput17, pubInput18, pubInput19, pubInput20, pubInput21, pubInput22, pubInput23, pubInput24, pubInput25, pubInput26, pubInput27, pubInput28, pubInput29, pubInput30, pubInput31, pubInput32, pubInput33, pubInput34, pubInput35, pubInput36, pubInput37, pubInput38, pubInput39, pubInput40, pubInput41, pubInput42, pubInput43, pubInput44, pubInput45, pubInput46, pubInput47, pubInput48, pubInput49, pubInput50, pubInput51, pubInput52, pubInput53, pubInput54, pubInput55, pubInput56, pubInput57, pubInput58, pubInput59, pubInput60, pubInput61, pubInput62, pubInput63, pubInput64, pubInput65, pubInput66, pubInput67, pubInput68, pubInput69, pubInput70, pubInput71, pubInput72, pubInput73, pubInput74, pubInput75, pubInput76, pubInput77, pubInput78, pubInput79, pubInput80),
      ic(done + 3), pubInputAt(done + 2, pubInput0, pubInput1, pubInput2, pubInput3, pubInput4, pubInput5, pubInput6, pubInput7, pubInput8, pubInput9, pubInput10, pubInput11, pubInput12, pubInput13, pubInput14, pubInput15, pubInput16, pubInput17, pubInput18, pubInput19, pubInput20, pubInput21, pubInput22, pubInput23, pubInput24, pubInput25, pubInput26, pubInput27, pubInput28, pubInput29, pubInput30, pubInput31, pubInput32, pubInput33, pubInput34, pubInput35, pubInput36, pubInput37, pubInput38, pubInput39, pubInput40, pubInput41, pubInput42, pubInput43, pubInput44, pubInput45, pubInput46, pubInput47, pubInput48, pubInput49, pubInput50, pubInput51, pubInput52, pubInput53, pubInput54, pubInput55, pubInput56, pubInput57, pubInput58, pubInput59, pubInput60, pubInput61, pubInput62, pubInput63, pubInput64, pubInput65, pubInput66, pubInput67, pubInput68, pubInput69, pubInput70, pubInput71, pubInput72, pubInput73, pubInput74, pubInput75, pubInput76, pubInput77, pubInput78, pubInput79, pubInput80),
      ic(done + 4), pubInputAt(done + 3, pubInput0, pubInput1, pubInput2, pubInput3, pubInput4, pubInput5, pubInput6, pubInput7, pubInput8, pubInput9, pubInput10, pubInput11, pubInput12, pubInput13, pubInput14, pubInput15, pubInput16, pubInput17, pubInput18, pubInput19, pubInput20, pubInput21, pubInput22, pubInput23, pubInput24, pubInput25, pubInput26, pubInput27, pubInput28, pubInput29, pubInput30, pubInput31, pubInput32, pubInput33, pubInput34, pubInput35, pubInput36, pubInput37, pubInput38, pubInput39, pubInput40, pubInput41, pubInput42, pubInput43, pubInput44, pubInput45, pubInput46, pubInput47, pubInput48, pubInput49, pubInput50, pubInput51, pubInput52, pubInput53, pubInput54, pubInput55, pubInput56, pubInput57, pubInput58, pubInput59, pubInput60, pubInput61, pubInput62, pubInput63, pubInput64, pubInput65, pubInput66, pubInput67, pubInput68, pubInput69, pubInput70, pubInput71, pubInput72, pubInput73, pubInput74, pubInput75, pubInput76, pubInput77, pubInput78, pubInput79, pubInput80)
      , 4
    );

    if (!haveAcc) {
      acc = tail;
      haveAcc = true;
    } else {
      acc = blsG1Add(acc, tail);
    }

    done += 4;
  }

  // Final cpub = IC0 + acc (IC0 is always added exactly once)
  var cpub: slice;
  if (!haveAcc) {
    cpub = IC0;
  } else {
    cpub = blsG1Add(acc, IC0);
  }

  // Pairing check: e(cpub, gamma) * e(-piA, piB) * e(piC, delta) * e(alpha, beta) == 1
  var piANeg: slice = blsG1Neg(piA);
  var ok: int = blsPairing(
    cpub,       VK_GAMMA_2,
    piANeg,     piB,
    piC,        VK_DELTA_2,
    VK_ALPHA_1, VK_BETA_2,
    4
  );

  return ok != 0;
}

struct (0x3b3cca17) Verify {
  piA: cell
  piB: cell
  piC: cell
  pubInputs: RemainingBitsAndRefs
}

fun verifyProof(msg: Verify): bool {
  var piA: slice = msg.piA.beginParse();
  var piB: slice = msg.piB.beginParse();
  var piC: slice = msg.piC.beginParse();
  var payload: slice = msg.pubInputs;

  if (payload.loadUint(8) != N_PUBLIC) { throw(ERR_INVALID_INPUTS); }
  var pubInput0: int = loadNextPubInput(mutate payload);
  var pubInput1: int = loadNextPubInput(mutate payload);
  var pubInput2: int = loadNextPubInput(mutate payload);
  var pubInput3: int = loadNextPubInput(mutate payload);
  var pubInput4: int = loadNextPubInput(mutate payload);
  var pubInput5: int = loadNextPubInput(mutate payload);
  var pubInput6: int = loadNextPubInput(mutate payload);
  var pubInput7: int = loadNextPubInput(mutate payload);
  var pubInput8: int = loadNextPubInput(mutate payload);
