  var pubInput15: int = loadNextPubInput(mutate payload);
  var pubInput16: int = loadNextPubInput(mutate payload);
  var pubInput17: int = loadNextPubInput(mutate payload);
  var pubInput18: int = loadNextPubInput(mutate payload);
  var pubInput19: int = loadNextPubInput(mutate payload);
  var pubInput20: int = loadNextPubInput(mutate payload);
  var pubInput21: int = loadNextPubInput(mutate payload);
  var pubInput22: int = loadNextPubInput(mutate payload);
  var pubInput23: int = loadNextPubInput(mutate payload);
  var pubInput24: int = loadNextPubInput(mutate payload);
  var pubInput25: int = loadNextPubInput(mutate payload);
  var pubInput26: int = loadNextPubInput(mutate payload);
  var pubInput27: int = loadNextPubInput(mutate payload);
  var pubInput28: int = loadNextPubInput(mutate payload);
  var pubInput29: int = loadNextPubInput(mutate payload);
  var pubInput30: int = loadNextPubInput(mutate payload);
  var pubInput31: int = loadNextPubInput(mutate payload);
  var pubInput32: int = loadNextPubInput(mutate payload);
  var pubInput33: int = loadNextPubInput(mutate payload);
  var pubInput34: int = loadNextPubInput(mutate payload);
  var pubInput35: int = loadNextPubInput(mutate payload);
  var pubInput36: int = loadNextPubInput(mutate payload);
  var pubInput37: int = loadNextPubInput(mutate payload);
  var pubInput38: int = loadNextPubInput(mutate payload);
  var pubInput39: int = loadNextPubInput(mutate payload);
  var pubInput40: int = loadNextPubInput(mutate payload);
  var pubInput41: int = loadNextPubInput(mutate payload);
  var pubInput42: int = loadNextPubInput(mutate payload);
  var pubInput43: int = loadNextPubInput(mutate payload);
  var pubInput44: int = loadNextPubInput(mutate payload);
  var pubInput45: int = loadNextPubInput(mutate payload);
