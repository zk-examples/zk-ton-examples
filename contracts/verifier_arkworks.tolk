
import "@stdlib/exotic-cells"

contract Verifier {
  description: "Groth16 verifier generated by export-ton-verifier"
  storage: VerifierStorage
  incomingMessages: Verify
}

/// This verifier is stateless.
/// It does not provide:
/// - nullifier replay protection;
/// - nonce or query-id protection;
/// - known-root validation;
/// - recipient binding;
/// - chain-id or contract-address domain separation;
/// - state-transition validation.

/// Empty persistent storage; verifier constants are embedded in code.
struct VerifierStorage {}

// IC0 is the constant term
const IC0: slice = "8ac5e8f7c6a6be828b6a9d61dfd39edeac1470de0d020f105879f0945400db0fa5dcff19aa07f94b1d205ae4e0aa2030".hexToSlice()
const IC1: slice = "89c2a2c0be0166dbe04e987fba86692210ad61e6c55b43c0e95137f8e71197111c003f2c34278cd07f279c389309e294".hexToSlice()

const VK_GAMMA_2: slice = "b2ad8b14b088d8e733636ad283a33fa1d07f4bc68e2751ff7b41e602d222667a34705f308a9fb93d3807edc351b5bb9108c69616e984d8f00ab3a0f32789fb22f628ab866de12ff12b21eeb4f9b3774b23ac423cdb441cae7ce4e45bc419c2e4".hexToSlice()
const VK_DELTA_2: slice = "a74849fdb33c6ffee0f2c16704c7be36715fa3d4b8b3479472d06f7364ca587b848e9371a0872746a1424bfa2743afb50245c703c1326e50be17478288ed35998d1ea96727dda5783d8d5024fd903ba33141f159c82f84ec72b81e841492bf96".hexToSlice()
const VK_ALPHA_1: slice = "8e5b5c643d8a97c0f60669ce1c3d3f0fb38331b4fc30bb0ab616ff1ea1f33b7191e9033022a957e9f64d901948a4cb6e".hexToSlice()
const VK_BETA_2:  slice = "a3db20d891b38d287b576cfc1ade7260eedf7eb859dfabf641868f6edb6504778b03e3afbeb97bbe484ffd8dac4c3071068b64cd8b60485785e3533c59c52f84dd03cfd373254d2f737edb65ba583562db9379d9762bf4fb3cd7df3f8ea9a01b".hexToSlice()

const N_PUBLIC: int = 1

const MIN_VERIFY_VALUE: coins = 50000000

enum VerifierErrors {
  InvalidInputs = 258,
  WrongProof = 260,
  NotEnoughValue = 261,
}


/// # Safety
/// Expects both slices to contain canonically encoded BLS12-381 G1 points
/// accepted by the TVM `BLS_G1_ADD` opcode.
@pure fun blsG1Add(x: slice, y: slice): slice asm "BLS_G1_ADD";

/// # Safety
/// Expects the slice to contain a canonically encoded BLS12-381 G1 point
/// accepted by the TVM `BLS_G1_NEG` opcode.
@pure fun blsG1Neg(x: slice): slice asm "BLS_G1_NEG";

@pure fun blsG1InGroup(x: slice): bool asm "BLS_G1_INGROUP";
@pure fun blsG2InGroup(x: slice): bool asm "BLS_G2_INGROUP";
@pure fun blsG1IsZero(x: slice): bool asm "BLS_G1_ISZERO";
@pure fun blsG2IsZero(x: slice): bool asm "BLS_G2_ISZERO";

fun checkProofPoints(piA: slice, piB: slice, piC: slice) {
  if (
    piA.remainingBitsCount() != 384 || piA.remainingRefsCount() != 0 ||
    piB.remainingBitsCount() != 768 || piB.remainingRefsCount() != 0 ||
    piC.remainingBitsCount() != 384 || piC.remainingRefsCount() != 0
  ) {
    throw VerifierErrors.InvalidInputs;
  }
  if (!blsG1InGroup(piA) || !blsG2InGroup(piB) || !blsG1InGroup(piC)) {
    throw VerifierErrors.InvalidInputs;
  }
  if (blsG1IsZero(piA) || blsG2IsZero(piB) || blsG1IsZero(piC)) {
    throw VerifierErrors.InvalidInputs;
  }
}

fun loadCheckedG1(point: cell): slice {
  val (pointSlice, isExotic) = point.beginParseSpecial();
  if (isExotic || pointSlice.remainingBitsCount() != 384 || pointSlice.remainingRefsCount() != 0) {
    throw VerifierErrors.InvalidInputs;
  }
  return pointSlice;
}

fun loadCheckedG2(point: cell): slice {
  val (pointSlice, isExotic) = point.beginParseSpecial();
  if (isExotic || pointSlice.remainingBitsCount() != 768 || pointSlice.remainingRefsCount() != 0) {
    throw VerifierErrors.InvalidInputs;
  }
  return pointSlice;
}

fun loadCheckedProof(proof: cell): (slice, slice, slice) {
  val (initialProof, isExotic) = proof.beginParseSpecial();
  var proofSlice = initialProof;
  if (isExotic || proofSlice.remainingBitsCount() != 0 || proofSlice.remainingRefsCount() != 3) {
    throw VerifierErrors.InvalidInputs;
  }
  val piA = loadCheckedG1(proofSlice.loadRef());
  val piB = loadCheckedG2(proofSlice.loadRef());
  val piC = loadCheckedG1(proofSlice.loadRef());
  proofSlice.assertEnd();
  return (piA, piB, piC);
}

@pure fun blsR(): int asm "BLS_PUSHR";

fun checkPublicInput(x: int): int {
  // TVM scalar multiplication reduces modulo r, so x and x+r would otherwise alias.
  if (x < 0 || x >= blsR()) {
    throw VerifierErrors.InvalidInputs;
  }
  return x;
}

/// # Safety
/// Expects the provided slices to contain canonically encoded BLS12-381 proof
/// and verification-key points in the order required by TVM `BLS_PAIRING`.
@pure fun blsPairing(
  x1: slice, y1: slice,
  x2: slice, y2: slice,
  x3: slice, y3: slice,
  x4: slice, y4: slice,
  n: int
): int asm "BLS_PAIRING";

/// # Safety
/// Expects x1..x1 to be canonical BLS12-381 G1 points and y1..y1
/// to be scalars encoded in the format expected by TVM `BLS_G1_MULTIEXP`.
@pure
fun blsG1Multiexp1(
  x1: slice, y1: int,
  n: int
): slice asm "BLS_G1_MULTIEXP";


// Internal messages carry public inputs as a custom payload:
// uint8 length, then canonical three-int257 chunks chained through refs.
fun checkPublicInputsPayloadShape(payload: slice) {
  var remaining: int = 1;

  while (remaining > 0) {
    var chunk: int = remaining;
    if (chunk > 3) { chunk = 3; }
    if (payload.remainingBitsCount() != chunk * 257) { throw VerifierErrors.InvalidInputs; }
    remaining -= chunk;

    if (remaining > 0) {
      if (payload.remainingRefsCount() != 1) { throw VerifierErrors.InvalidInputs; }
      val (nextPayload, isExotic) = payload.loadRef().beginParseSpecial();
      if (isExotic) { throw VerifierErrors.InvalidInputs; }
      payload = nextPayload;
    } else if (payload.remainingRefsCount() != 0) {
      throw VerifierErrors.InvalidInputs;
    }
  }
}

fun loadNextPubInput(mutate payload: slice): int {
  if (payload.remainingBitsCount() < 257) {
    if (payload.remainingBitsCount() != 0 || payload.remainingRefsCount() != 1) {
      throw VerifierErrors.InvalidInputs;
    }
    val (nextPayload, isExotic) = payload.loadRef().beginParseSpecial();
    if (isExotic || nextPayload.remainingBitsCount() < 257) {
      throw VerifierErrors.InvalidInputs;
    }
    payload = nextPayload;
  }
  return checkPublicInput(payload.loadInt(257));
}

fun finishGroth16(
  piA: slice,
  piB: slice,
  piC: slice,
  acc: slice,
  haveAcc: bool
): bool {
  // Final cpub = IC0 + acc (IC0 is always added exactly once)
  var cpub: slice;
  if (!haveAcc) {
    cpub = IC0;
  } else {
    cpub = blsG1Add(acc, IC0);
  }

  // Pairing check: e(cpub, gamma) * e(-piA, piB) * e(piC, delta) * e(alpha, beta) == 1
  val piANeg: slice = blsG1Neg(piA);
  val ok: int = blsPairing(
    cpub,         VK_GAMMA_2,
    piANeg,       piB,
    piC,          VK_DELTA_2,
    VK_ALPHA_1, VK_BETA_2,
    4
  );

  return ok != 0;
}

fun groth16VerifyPayload(
  piA: slice,
  piB: slice,
  piC: slice,
  mutate payload: slice
): bool {
  checkProofPoints(piA, piB, piC);

  // Compute: cpub = IC0 + sum(pubInputs[i] * IC(i+1))
  var haveAcc: bool = false;
  var acc: slice = IC0; // placeholder until haveAcc == true

  val y1: int = loadNextPubInput(mutate payload);
  acc = blsG1Multiexp1(
    IC1, y1
    , 1
  );
  haveAcc = true;

  if (payload.remainingBitsCount() != 0 || payload.remainingRefsCount() != 0) {
    throw VerifierErrors.InvalidInputs;
  }

  return finishGroth16(piA, piB, piC, acc, haveAcc);
}

fun groth16VerifyArray(piA: slice, piB: slice, piC: slice, pubInputs: array<int>): bool {
  checkProofPoints(piA, piB, piC);
  if (pubInputs.size() != N_PUBLIC) { throw VerifierErrors.InvalidInputs; }

  // Compute: cpub = IC0 + sum(pubInputs[i] * IC(i+1))
  var haveAcc: bool = false;
  var acc: slice = IC0; // placeholder until haveAcc == true

  acc = blsG1Multiexp1(
    IC1, checkPublicInput(pubInputs.get(0))
    , 1
  );
  haveAcc = true;

  return finishGroth16(piA, piB, piC, acc, haveAcc);
}

/// Internal message containing Groth16 proof points and serialized public inputs.
struct (0x3b3cca17) Verify {
  /// Ordinary cell with exactly three refs: piA, piB, piC.
  proof: cell
  /// Ordinary cell with uint8 length followed by a linear int257 ref chain.
  pubInputs: cell
}

fun verifyProof(msg: Verify): bool {
  val (piA, piB, piC) = loadCheckedProof(msg.proof);
  val (initialPayload, payloadIsExotic) = msg.pubInputs.beginParseSpecial();
  var payload = initialPayload;

  if (payloadIsExotic || payload.remainingBitsCount() < 8) { throw VerifierErrors.InvalidInputs; }
  if (payload.loadUint(8) != N_PUBLIC) { throw VerifierErrors.InvalidInputs; }
  checkPublicInputsPayloadShape(payload);

  return groth16VerifyPayload(piA, piB, piC, mutate payload);
}

fun onInternalMessage(inMsg: InMessage) {
  val msg = lazy Verify.fromSlice(inMsg.body);

  match (msg) {
    Verify => {
      assert (inMsg.valueCoins >= MIN_VERIFY_VALUE) throw VerifierErrors.NotEnoughValue;
      val messageTail = msg.forceLoadLazyObject();
      if (!messageTail.isEmpty()) { throw VerifierErrors.InvalidInputs; }
      assert (verifyProof(msg)) throw VerifierErrors.WrongProof;
    }
    else => {
      assert (inMsg.body.isEmpty()) throw VerifierErrors.InvalidInputs;
    }
  }
}

/// Verifies a Groth16 proof against public inputs.
get fun verify(piA: slice, piB: slice, piC: slice, pubInputs: array<int>): bool {
  return groth16VerifyArray(piA, piB, piC, pubInputs);
}

