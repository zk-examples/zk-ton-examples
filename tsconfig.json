{
    "compilerOptions": {
        "target": "ES2020",
        "outDir": "dist",
        "module": "Node16",
        "moduleResolution": "node16",
        "declaration": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "isolatedModules": true,
        "strict": true,
        "skipLibCheck": true,
        "types": ["node", "jest"]
    },
    "include": [
        "jest.config.ts",
        "jest.setup.ts",
        "tests/**/*.ts",
        "wrappers/**/*.ts",
        "build/**/*.ts",
        "scripts/**/*.ts"
    ]
}
