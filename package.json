{
    "name": "zk-ton-example",
    "version": "0.0.1",
    "packageManager": "npm@11.13.0",
    "engines": {
        "node": "24.16.0"
    },
    "license": "MIT",
    "scripts": {
        "bp": "blueprint",
        "start": "blueprint run",
        "build": "blueprint build",
        "circuits:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/compileMultiplier.ps1",
        "circuits:check": "node scripts/checkMultiplierArtifact.js",
        "noname:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/installNoname.ps1",
        "fixtures:snarkjs:build": "npm run circuits:build && ts-node scripts/rebuildSnarkjsFixtures.ts --all",
        "fixtures:native:build": "ts-node scripts/rebuildNativeFixtures.ts",
        "fixtures:record": "ts-node scripts/fixtureManifest.ts --record",
        "fixtures:verify": "ts-node scripts/fixtureManifest.ts --verify",
        "fixtures:build": "npm run fixtures:snarkjs:build && npm run fixtures:native:build && npm run fixtures:record",
        "pretest": "npm run circuits:check && npm run fixtures:verify",
        "test": "jest --verbose --runInBand",
        "generate:verifiers": "ts-node scripts/regenerate-verifiers.ts"
    },
    "dependencies": {
        "@ton/convert-func-to-tolk": "^1.0.0",
        "@ton/core": "~0",
        "@types/snarkjs": "^0.7.9",
        "export-ton-verifier": "^3.0.3",
        "snarkjs": "^0.7.6"
    },
    "devDependencies": {
        "@tact-lang/compiler": ">=1.6.13 <2.0.0",
        "@ton-community/func-js": ">=0.11.0",
        "@ton/blueprint": ">=0.45.0",
        "@ton/crypto": "^3.3.0",
        "@ton/sandbox": ">=0.44.0",
        "@ton/test-utils": ">=0.12.0",
        "@ton/tolk-js": ">=1.4.2",
        "@ton/ton": "^16.3.0",
        "@types/jest": "^30.0.0",
        "@types/mocha": "^10.0.10",
        "@types/node": "^25.9.4",
        "jest": "^30.4.2",
        "prettier": "^3.9.6",
        "ts-jest": "^29.4.11",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3"
    },
    "overrides": {
        "axios": "^1.18.1",
        "js-yaml": "^4.2.0",
        "protobufjs": "^7.6.4",
        "underscore": "^1.13.8"
    }
}
